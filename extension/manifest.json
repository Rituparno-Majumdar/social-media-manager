{
  "manifest_version": 3,
  "name": "SocialCraft AI Copilot",
  "version": "1.0.0",
  "description": "Cross-browser posting companion for SocialCraft AI. Automates copy-pasting for multi-platform campaigns.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://*.twitter.com/*",
    "https://*.x.com/*",
    "https://*.facebook.com/*",
    "https://*.instagram.com/*",
    "https://*.linkedin.com/*",
    "https://*.sharechat.com/*",
    "https://*.threads.net/*",
    "https://*.pinterest.com/*",
    "https://*.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.twitter.com/*",
        "https://*.x.com/*",
        "https://*.facebook.com/*",
        "https://*.instagram.com/*",
        "https://*.linkedin.com/*",
        "https://*.sharechat.com/*",
        "https://*.threads.net/*",
        "https://*.pinterest.com/*",
        "https://*.youtube.com/*"
      ],
      "js": ["content_scripts/copilot.js"],
      "css": ["content_scripts/copilot.css"],
      "run_at": "document_end"
    },
    {
      "matches": [
        "file:///*",
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://*.github.io/*"
      ],
      "js": ["extension_bridge.js"],
      "run_at": "document_end"
    }
  ]
}
